# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local

# node_modules are not needed at runtime — the production server bundle is fully
# self-contained (esbuild), and the dashboard is pre-built static files.
**/node_modules

# Chat-attached screenshots and images (can be 400MB+) — exclude at any depth.
**/attached_assets

# Video production artifacts — not needed at runtime.
ep1-video
