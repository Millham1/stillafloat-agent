# Generated news pages (written on the box by the news pre-renderer —
# server/src/lib/prerender-news.ts). The listing pages news.html + es/news.html
# are generated too: keeping them tracked meant every deploy's `git reset --hard`
# briefly reverted /news.html to a legacy JS-rendered page until the on-boot
# prerender rewrote it (the "quirky More News button" flip-flop).
server/public/news/
server/public/es/news/
server/public/news-sitemap.xml
server/public/news.html
server/public/es/news.html

# local caches + box-local runtime files (keep out of git)
.cache/
.local/
server/.env
server/start.sh
server/ecosystem.config.cjs

# cabin-advisor: per-ship intermediate chunks that combine into *-full.json.
# Derived output — regenerate rather than version ~4MB of them.
cabin-advisor/data/cabins/parts/

# cabin-advisor working artifacts (2026-08-21 hygiene review)
.claude/
Icon?
cabin-advisor/logs/
cabin-advisor/noise/
cabin-advisor/widgety-cache/
cabin-advisor/widgety-reads.json
cabin-advisor/carnival/*.rooms.json
cabin-advisor/carnival/missing_resolved.json
cabin-advisor/geometry/work/
cabin-advisor/geometry/*-src/
cabin-advisor/geometry/results_*.jsonl
cabin-advisor/geometry/state.json

# deploy-time side builds (atomic swap in deploy.yml)
**/dist.next/
**/dist.prev/
